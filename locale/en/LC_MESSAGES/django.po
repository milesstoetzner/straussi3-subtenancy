msgid ""
"Der Begin des Untermietvertrages ist vor dem Beginn des Hauptmietvertrages!"
msgstr ""
"The Begin of the Subtenancy Contract is before the Begin of the Maintenant "
"Contract!"

#: .\contracts\forms.py:53
msgid ""
"Das Ende des Untermietvertrages ist nach dem Ende des Hauptmietvertrages!"
