[Unit]
Description=uWSGI Emperor service

[Service]
#ExecStartPre=/bin/bash -c 'sudo mkdir -p /var/run/uwsgi; chown www-data:www-data /var/run/uwsgi'
ExecStart=/usr/bin/uwsgi_python3 --emperor /etc/uwsgi/sites --uid www-data --gid www-data --venv /var/www/ferienmiete/
Restart=always
KillSignal=SIGQUIT
Type=notify
NotifyAccess=all
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
