#: .\contracts\forms.py:93
msgid ""
"Der Hauptmieter überschreitet die 3 Monate Grenze! Falls er eine "
"Sondergenehmigung besitzt, kann dies unten angegeben werden."
msgstr ""

#: .\contracts\forms.py:97
msgid "Dein Zimmer muss in einem ordnungsgemäßen Zustand sein!"
msgstr "Your Room has to be clean and in a proper Condition!"

#: .\contracts\forms.py:101
msgid "Deine Wohnung muss in einem ordnungsgemäßen Zustand sein!"
msgstr "Your flat has to be in a proper Condition!"

